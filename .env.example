# Per node addresses. scripts/desensitize.sh replaces any value appearing
# in synced results with its variable name, in the order listed here.
NODE1_IP=10.0.0.1
NODE2_IP=10.0.0.2
NODE3_IP=10.0.0.3
NODE4_IP=10.0.0.4
NODE1_HOST=node1.example.com
NODE2_HOST=node2.example.com
NODE3_HOST=node3.example.com
NODE4_HOST=node4.example.com
# Coordinator ip reachable from the benchmark node, fills the
# ${CLUSTER_IP} placeholder in the config templates via scripts/run.sh.
CLUSTER_IP=10.0.0.1
